---
import { link, abs, NOINDEX } from '../data/paths';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Ekstra JSON-LD-objekter til denne side. */
  schema?: Record<string, unknown>[];
  contact?: { heading?: string; text?: string };
  noindex?: boolean;
}
const { title, description = site.description, schema = [], contact, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, abs('/')).href;
const ogImage = abs('/og.png');

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': abs('/#organization'),
  name: site.name,
  url: abs('/'),
  logo: abs('/logo.svg'),
  description: site.description,
  slogan: site.principle,
  email: site.email,
  ...(site.phone && { telephone: site.phone }),
  ...(site.cvr && { vatID: `DK${site.cvr}` }),
  areaServed: { '@type': 'Country', name: 'Danmark' },
  founder: site.founders.map((name) => ({ '@type': 'Person', name })),
  knowsAbout: [
    'Hjemmesider til mindre virksomheder',
    'Hosting',
    'E-mail',
    'Flytning af hjemmeside',
    'Flytning af e-mail',
  ],
};
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || NOINDEX) && <meta name="robots" content="noindex" />}
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={link('/sitemap.xml')} />
    <meta name="theme-color" content="#1F3A8A" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([organization, ...schema])} />
  </head>
  <body>
    <a class="skip-link" href="#indhold">Gå til indhold</a>
    <Header />
    <main id="indhold">
      <slot />
    </main>
    <ContactBlock {...contact} />
  </body>
</html>
