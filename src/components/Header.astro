---
import { link } from '../data/paths';
import Logo from './Logo.astro';
import { nav } from '../data/site';

const path = Astro.url.pathname;
// "page" på den aktuelle side, "true" på en overordnet sektion (fx Pris under produktet)
const current = (href: string) =>
  path === link(href) ? 'page' : href !== '/' && path.startsWith(link(href)) ? 'true' : undefined;
---

<div class="bar blue on-dark">
  <header class="wrap">
    <a href={link('/')} class="home" aria-label="D&O Digital, forside">
      <Logo variant="negative" />
    </a>
    <nav aria-label="Hovedmenu">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={link(item.href)} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={link('/kontakt/')} class="cta" aria-current={current('/kontakt/')}>Kontakt os</a>
        </li>
      </ul>
    </nav>
  </header>
</div>

<style>
  .bar {
    position: relative;
    z-index: 1;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    min-height: 88px;
    padding-block: 12px;
  }
  .home {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: 15px;
    color: var(--on-dark);
    text-decoration: none;
    text-underline-offset: 6px;
  }
  nav a:hover {
    text-decoration: underline;
  }
  nav a[aria-current] {
    font-weight: 700;
    color: var(--accent-light);
    text-decoration: underline;
  }
  nav a.cta {
    padding: 0 22px;
    border-radius: var(--radius);
    background: var(--accent-light);
    color: var(--btn-ink);
    font-weight: 700;
    text-decoration: none;
  }
  nav a.cta:hover {
    background: #fff;
  }
  @media (max-width: 720px) {
    header {
      padding-block: 16px 8px;
    }
    ul {
      gap: 0 18px;
    }
    nav a {
      font-size: 14px;
    }
  }
</style>
