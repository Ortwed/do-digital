---
import { link } from '../data/paths';
import CaseVisual from './CaseVisual.astro';
import { cases } from '../data/cases';
interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class="cases">
  {
    cases.map((c, i) => (
      <li class:list={['panel', i % 2 ? 'orange' : 'blue-tint']}>
        <div class="media">
          <CaseVisual item={c} />
        </div>
        <div class="text">
          <H class="name">{c.client}</H>
          <p class="muted">{c.teaser}</p>
          <div class="links">
            <a class="link-arrow" href={link(`/cases/${c.slug}/`)}>
              Læs casen <span class="sr-only">om {c.client}</span>
              <span aria-hidden="true">→</span>
            </a>
            <a class="link-arrow" href={c.url} rel="noopener">
              Se hjemmesiden <span class="sr-only">{c.domain}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .panel {
    border-radius: var(--radius-panel);
    padding: clamp(20px, 4vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }
  .blue-tint {
    background: var(--tint);
  }
  .orange {
    background: var(--tint-orange);
  }
  /* Hvert andet kort har billedet til højre, som i designet */
  @media (min-width: 900px) {
    .orange .media {
      order: 2;
    }
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .name {
    font-weight: 800;
    font-size: clamp(26px, 3vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .text p {
    font-size: 18px;
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
</style>
