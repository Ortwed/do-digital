---
import CaseVisual from './CaseVisual.astro';
import { cases } from '../data/cases';
interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class="rule-list cases">
  {
    cases.map((c) => (
      <li class="case">
        <a href={`/cases/${c.slug}/`} class="visual-link" tabindex="-1" aria-hidden="true">
          <CaseVisual item={c} />
        </a>
        <div class="text">
          <H class="name">
            <a href={`/cases/${c.slug}/`}>{c.client}</a>
          </H>
          <p class="muted">{c.teaser}</p>
        </div>
        <div class="links">
          <a class="link-arrow" href={`/cases/${c.slug}/`}>
            Læs casen <span aria-hidden="true">→</span>
          </a>
          <a class="link-arrow ext" href={c.url} rel="noopener">
            {c.domain} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .case {
    display: grid !important;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr) auto;
    gap: 24px 40px;
    align-items: center;
    padding: 32px 0 !important;
  }
  @media (max-width: 820px) {
    .case {
      grid-template-columns: 1fr;
    }
    .visual-link {
      max-width: 420px;
    }
  }
  .visual-link {
    display: block;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .case:hover .visual-link {
    transform: translateY(-2px);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .name {
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .name a {
    text-decoration: none;
  }
  .name a:hover {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .ext {
    font-weight: 600;
    color: var(--muted);
    font-size: 15px;
  }
</style>
