---
import { link } from '../data/paths';
import Logo from './Logo.astro';
import { site } from '../data/site';
---

<footer class="footer on-dark">
  <div class="wrap inner">
    <a href={link('/')} aria-label="D&O Digital, forside" class="home"><Logo variant="negative" size={35} /></a>
    <p>{site.tagline}</p>
    <p class="small">© {new Date().getFullYear()} {site.name} · {site.cvr ? `CVR ${site.cvr}` : '[CVR]'}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--on-dark-muted);
  }
  .inner {
    padding-block: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .home {
    text-decoration: none;
  }
  .small {
    font-size: 14px;
  }
</style>
