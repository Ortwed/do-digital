---
import type { Case } from '../data/cases';
import { link } from '../data/paths';
interface Props {
  item: Case;
  height?: number;
}
const { item, height = 340 } = Astro.props;
---

<figure class="visual">
  <div class="chrome" aria-hidden="true">
    <span></span><span></span><span></span>
    <div class="address">{item.domain}</div>
  </div>
  {
    item.image ? (
      <img src={link(item.image)} alt={`Forsiden af ${item.domain}`} loading="lazy" width="1600" height="1000" />
    ) : (
      <div class="placeholder" style={`min-height:${height}px`}>
        [Screenshot af {item.domain}]
      </div>
    )
  }
</figure>

<style>
  .visual {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
  }
  .chrome {
    height: 44px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    background: var(--chrome);
  }
  .chrome span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--chrome-dot);
  }
  .address {
    margin-left: 12px;
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .placeholder {
      min-height: 200px !important;
    }
  }
</style>
