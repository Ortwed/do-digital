---
import type { Case } from '../data/cases';
interface Props {
  item: Case;
  large?: boolean;
}
const { item, large = false } = Astro.props;
---

<figure class:list={['visual', { large }]}>
  <div class="chrome" aria-hidden="true">
    <span></span><span></span><span></span>
    <div class="address">{item.domain}</div>
  </div>
  {
    item.image ? (
      <img src={item.image} alt={`Forsiden af ${item.domain}`} loading="lazy" width="1600" height="1000" />
    ) : (
      <div class="placeholder">
        <span class="client">{item.client}</span>
        <span class="industry">{item.industry}</span>
      </div>
    )
  }
</figure>

<style>
  .visual {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgb(18 28 58 / 0.06), 0 12px 32px -12px rgb(18 28 58 / 0.18);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
  }
  .chrome span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
  }
  .address {
    margin-left: 8px;
    flex: 1;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--bg);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .placeholder {
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    padding: 20px;
    background:
      linear-gradient(135deg, transparent 0 60%, rgb(31 58 138 / 0.08) 60% 100%),
      var(--tint);
  }
  .client {
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.02em;
    color: var(--brand);
  }
  .industry {
    font-size: 13px;
    color: var(--muted);
  }
  .large .client {
    font-size: clamp(22px, 3vw, 34px);
  }
  .large .placeholder {
    padding: clamp(20px, 4vw, 40px);
  }
</style>
