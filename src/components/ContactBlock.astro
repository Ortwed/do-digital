---
import { link } from '../data/paths';
import { site } from '../data/site';

export interface ContactProps {
  /** "light": lys flade med blå knap. "blue": blå flade med orange knap. */
  variant?: 'light' | 'blue';
  heading?: string;
  /** Del af overskriften, der fremhæves i orange (kun på blå). */
  highlight?: string;
  text?: string;
  cta?: string;
}
const {
  variant = 'light',
  heading = 'Få styr på dit digitale fundament.',
  highlight,
  text = 'Kontakt os, så tager vi en snak om din hjemmeside, hosting og e-mail.',
  cta = 'Kontakt os',
} = Astro.props as ContactProps;
const tel = site.phone.replace(/\s+/g, '');
const blue = variant === 'blue';
---

<section class:list={['contact', { 'blue on-dark': blue }]} aria-labelledby="kontakt-heading">
  <div class="wrap inner">
    <h2 id="kontakt-heading" class="h-cta">
      {heading}
      {highlight && <>{' '}<span class="hl">{highlight}</span></>}
    </h2>
    <p class="lead">{text}</p>
    <div class="row">
      <a class:list={['btn', blue ? 'btn-light' : 'btn-primary btn-big']} href={link('/kontakt/')}>{cta}</a>
      <p class="details">
        {site.phone ? <a href={`tel:${tel}`}>{site.phone}</a> : <span>[TELEFON]</span>}
        <span aria-hidden="true">·</span>
        {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span>[E-MAIL]</span>}
      </p>
    </div>
  </div>
</section>

<style>
  .inner {
    padding-block: var(--section-y);
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: flex-start;
  }
  .h-cta {
    max-width: 900px;
    font-size: clamp(38px, 5.4vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }
  .btn-big {
    min-height: 54px;
    padding: 0 32px;
    font-size: 17px;
  }
  .details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-weight: 600;
    font-size: 17px;
  }
  .details a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .details a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
